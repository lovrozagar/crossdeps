{
	"name": "crossdeps-monorepo",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.11",
	"workspaces": {
		"packages": [
			"packages/*",
			"examples/*",
			"e2e/*"
		],
		"catalog": {
			"@types/node": "26.1.1",
			"bun-types": "1.3.14",
			"typescript": "7.0.2",
			"vitest": "4.1.10"
		}
	},
	"scripts": {
		"test": "bun run --filter @scriptgun/crossdeps test",
		"test:consumers": "bun test e2e/app/tests",
		"test:e2e:docker": "bash e2e/docker/run.sh",
		"test:watch": "bun run --filter @scriptgun/crossdeps test:watch",
		"typecheck": "bun run --filter @scriptgun/crossdeps type:check",
		"typecheck:consumers": "bun run --filter './examples/*' type:check && bun run --filter @crossdeps/e2e-app type:check"
	}
}
